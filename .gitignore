# build artifacts — single location (SPEC §C37)
dist/

# deps
node_modules/
.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
.ruff_cache/

# terraform — provider cache + state (SPEC §V14).
# .terraform.lock.hcl is NOT ignored: it pins provider hashes for CI.
.terraform/
*.tfstate
*.tfstate.*
# B2: real state that dodged the patterns above by being named .json.
# The content check in test_repo_hygiene.py is the actual guard.
infra/state.json

# env / secrets
.env
.env.*.local

# editor / os
.DS_Store
Thumbs.db

# vite-plugin-pwa dev-mode output
web/dev-dist/
